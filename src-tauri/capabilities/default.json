{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "clipboard-manager:allow-read-text",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "yt-dlp",
          "sidecar": true
        },
        {
          "name": "yt-dlp-wrapper",
          "sidecar": true
        },
        {
          "name": "ffmpeg",
          "sidecar": true
        },
        {
          "name": "ffprobe",
          "sidecar": true
        }
      ]
    }
  ]
}